# npm run dev and build:preview enable sample content explicitly.
# Production builds exclude sample and draft entries.
PREVIEW_CONTENT=false
# Indexing is enabled by default. Set this to false for preview deployments.
PUBLIC_INDEXING_ENABLED=true
# Drip runs only in production builds, excluding build:preview and Vercel previews.
# Public write keys may appear in the browser bundle; never use a server key here.
PUBLIC_DRIP_ENABLED=true
PUBLIC_DRIP_ENDPOINT=https://drip-api.willopc.com/v1/events
PUBLIC_DRIP_ALLOWED_ORIGINS=https://willopc.com
PUBLIC_DRIP_WRITE_KEY=
