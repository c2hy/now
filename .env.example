# npm run dev and build:preview enable sample content explicitly.
# Production builds exclude sample and draft entries.
PREVIEW_CONTENT=false
# Indexing is enabled by default. Set this to false for preview deployments.
PUBLIC_INDEXING_ENABLED=true
# Mixpanel runs only in production builds, excluding build:preview.
# The project token is public and will appear in the browser bundle.
PUBLIC_MIXPANEL_ENABLED=true
PUBLIC_MIXPANEL_TOKEN=
