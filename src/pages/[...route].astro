---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentDetail from '../components/ContentDetail.astro';
import Home from '../components/Home.astro';
import About from '../components/About.astro';
import WritingList from '../components/WritingList.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import { locales, ui, path, contentPath, type Locale } from '../i18n';
import { profile } from '../data/profile';
import { visible, translation } from '../utils/content';
export async function getStaticPaths() {
  const routes = [];
  for (const locale of locales) {
    for (const page of ['home', 'writing', 'projects', 'about'])
      routes.push({
        params: {
          route:
            path(
              locale,
              page === 'home' ? '' : page === 'writing' ? 'notes' : page,
            )
              .replace(/^\//, '')
              .replace(/\/$/, '') || undefined,
        },
        props: { locale, page },
      });
    for (const kind of ['writing', 'projects'] as const)
      for (const entry of (await getCollection(kind)).filter(
        (e) => e.data.locale === locale && visible(e.data),
      ))
        routes.push({
          params: {
            route: contentPath(locale, kind, entry.data.slug).slice(1),
          },
          props: { locale, page: kind, entry },
        });
  }
  return routes;
}
interface Props {
  locale: Locale;
  page: string;
  entry?: CollectionEntry<'writing'> | CollectionEntry<'projects'>;
}
const { locale, page, entry } = Astro.props as Props;
const t = ui[locale];
const home = page === 'home' ? await getEntry('home', locale) : undefined;
if (page === 'home' && !home)
  throw new Error(`Missing ${locale} opening essay`);
const article = entry?.collection === 'writing' ? entry : undefined;
const project = entry?.collection === 'projects' ? entry : undefined;
const title =
  article?.data.title ??
  project?.data.name ??
  home?.data.title ??
  t[page as 'writing' | 'projects' | 'about'];
const metaTitle =
  article?.data.seoTitle ??
  article?.data.title ??
  project?.data.seoTitle ??
  (project
    ? `${project.data.name} — ${project.data.statement}`
    : page === 'home'
      ? locale === 'en'
        ? `${profile.siteName} (${profile.alternateName}) — Independent Developer & Products`
        : `${profile.siteName}（${profile.alternateName}）｜独立开发者的作品与记录`
      : page === 'writing'
        ? locale === 'en'
          ? 'Writing — Observations, Decisions, and Experiments'
          : '文章｜生活、技术和做产品'
        : page === 'projects'
          ? locale === 'en'
            ? 'Projects — Ideas Put into Practice'
            : '作品｜把想法做出来'
          : page === 'about'
            ? locale === 'en'
              ? `About ${profile.siteName} (${profile.alternateName}) — Will in Shanghai`
              : `关于 ${profile.siteName}（${profile.alternateName}）｜独立开发者 Will`
            : undefined);
const pageDescription =
  entry?.data.description ??
  home?.data.description ??
  (page === 'writing'
    ? t.notesIntro
    : page === 'projects'
      ? t.projectsIntro
      : page === 'about'
        ? t.aboutIntro
        : t.siteIntro);
const alternate = entry
  ? await translation(entry.collection, entry.data.translationKey, locale)
  : undefined;
const ogImage = article
  ? {
      path: `/og/${locale}/notes/${article.data.slug}.png`,
      alt: article.data.title,
    }
  : project?.data.ogImage
    ? {
        path: project.data.ogImage.src,
        alt: project.data.ogImage.alt,
        width: project.data.ogImage.width,
        height: project.data.ogImage.height,
      }
    : undefined;
const writing =
  page === 'writing' && !entry
    ? (await getCollection('writing'))
        .filter((e) => e.data.locale === locale && visible(e.data))
        .sort(
          (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
        )
    : [];
const projects =
  page === 'projects' && !entry
    ? (await getCollection('projects'))
        .filter((e) => e.data.locale === locale && visible(e.data))
        .sort(
          (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
        )
    : [];
---

<BaseLayout
  locale={locale}
  title={title}
  metaTitle={metaTitle}
  description={pageDescription}
  current={page === 'home' ? undefined : page}
  alternate={alternate}
  product={project?.data.slug}
  article={article?.data}
  ogImage={ogImage}
>
  {home && <Home entry={home} />}
  {page === 'about' && <About locale={locale} />}
  {
    !entry && (page === 'writing' || page === 'projects') && (
      <section
        class={page === 'projects' ? 'project-gallery-page' : 'reading-column'}
      >
        <header class="reading-header">
          <h1>{t[page]}</h1>
        </header>
        {page === 'writing' ? (
          <WritingList items={writing} locale={locale} />
        ) : (
          <div class="project-gallery">
            {projects.map((item, index) => (
              <ProjectFeature
                item={item}
                locale={locale}
                priority={index === 0}
              />
            ))}
            {!projects.length && <p class="text-muted">{t.empty}</p>}
          </div>
        )}
      </section>
    )
  }
  {entry && <ContentDetail entry={entry} locale={locale} />}
</BaseLayout>
