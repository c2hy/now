---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentDetail from '../components/ContentDetail.astro';
import Home from '../components/Home.astro';
import About from '../components/About.astro';
import WritingList from '../components/WritingList.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import { locales, ui, path, contentPath, type Locale } from '../i18n';
import { profile } from '../data/profile';
import { visible, translation } from '../utils/content';
export async function getStaticPaths() {
  const routes = [];
  for (const locale of locales) {
    for (const page of ['home', 'writing', 'projects', 'about'])
      routes.push({
        params: {
          route:
            path(
              locale,
              page === 'home' ? '' : page === 'writing' ? 'notes' : page,
            )
              .replace(/^\//, '')
              .replace(/\/$/, '') || undefined,
        },
        props: { locale, page },
      });
    for (const kind of ['writing', 'projects'] as const)
      for (const entry of (await getCollection(kind)).filter(
        (e) => e.data.locale === locale && visible(e.data),
      ))
        routes.push({
          params: {
            route: contentPath(locale, kind, entry.data.slug).slice(1),
          },
          props: { locale, page: kind, entry },
        });
  }
  return routes;
}
interface Props {
  locale: Locale;
  page: string;
  entry?: CollectionEntry<'writing'> | CollectionEntry<'projects'>;
}
const { locale, page, entry } = Astro.props as Props;
const t = ui[locale];
const home = page === 'home' ? await getEntry('home', locale) : undefined;
if (page === 'home' && !home)
  throw new Error(`Missing ${locale} opening essay`);
const article = entry?.collection === 'writing' ? entry : undefined;
const project = entry?.collection === 'projects' ? entry : undefined;
const title =
  article?.data.title ??
  project?.data.name ??
  home?.data.title ??
  t[page as 'writing' | 'projects' | 'about'];
// 标题只分两类：首页是纯品牌名；栏目页用「内容名 + 品牌」，因为
// Writing / 文章 这类泛词单独出现在标签页里认不出是谁的站；内容详情页
// 只留内容标题，不再拖品牌后缀（部分英文标题本身已 50 字上下）。
const pageTitles: Record<
  Locale,
  Partial<Record<'home' | 'writing' | 'projects' | 'about', string>>
> = {
  en: {
    home: 'Will.OPC',
    writing: 'Writing — Will.OPC',
    projects: 'Projects — Will.OPC',
    about: 'About — Will.OPC',
  },
  zh: {
    home: 'Will.OPC',
    writing: '文章｜Will.OPC',
    projects: '作品｜Will.OPC',
    about: '关于｜Will.OPC',
  },
};
const metaTitle =
  article?.data.seoTitle ??
  article?.data.title ??
  project?.data.seoTitle ??
  (project
    ? `${project.data.name}${locale === 'zh' ? '｜' : ' — '}${project.data.statement}`
    : undefined) ??
  pageTitles[locale][page as 'home' | 'writing' | 'projects' | 'about'];
const pageDescription =
  entry?.data.description ??
  home?.data.description ??
  (page === 'writing'
    ? t.notesIntro
    : page === 'projects'
      ? t.projectsIntro
      : page === 'about'
        ? t.aboutIntro
        : t.siteIntro);
const alternate = entry
  ? await translation(entry.collection, entry.data.translationKey, locale)
  : undefined;
const ogImage = article
  ? {
      path: `/og/${locale}/notes/${article.data.slug}.png`,
      alt: article.data.title,
    }
  : project?.data.ogImage
    ? {
        path: project.data.ogImage.src,
        alt: project.data.ogImage.alt,
        width: project.data.ogImage.width,
        height: project.data.ogImage.height,
      }
    : page === 'home'
      ? {
          // 纸色区展示首页第一段（中英各一句），一张图放不下两种语言，
          // 因此按语言各出一张，各自在自己的页面上引用。
          path: locale === 'zh' ? '/og/home-zh.jpg' : '/og/home-en.jpg',
          alt:
            locale === 'zh'
              ? 'Will.OPC — 莫奈《阿让特伊的池塘》，1874'
              : 'Will.OPC — Claude Monet, Le bassin d’Argenteuil, 1874',
          width: 1200,
          height: 630,
        }
      : undefined;
// SoftwareApplication markup is limited to the app project that ships in both
// stores, so other project pages keep their existing schema.
const storeLinks =
  project?.data.links
    .filter((link) => link.type === 'app-store' || link.type === 'google-play')
    .map((link) => link.href) ?? [];
const app =
  project?.data.slug === 'tablow' && storeLinks.length
    ? {
        name: project.data.name,
        description: project.data.description,
        category: 'UtilitiesApplication',
        operatingSystem: 'iOS, iPadOS, Android',
        url: new URL(
          contentPath(locale, 'projects', project.data.slug),
          profile.site,
        ).href,
        downloadUrl: storeLinks[0],
        sameAs: storeLinks,
      }
    : undefined;
const writing =
  !entry && page === 'writing'
    ? (await getCollection('writing'))
        .filter((e) => e.data.locale === locale && visible(e.data))
        .sort(
          (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
        )
    : [];
const projects =
  !entry && page === 'projects'
    ? (await getCollection('projects'))
        .filter((e) => e.data.locale === locale && visible(e.data))
        .sort(
          (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
        )
    : [];
---

<BaseLayout
  locale={locale}
  title={title}
  metaTitle={metaTitle}
  description={pageDescription}
  current={page === 'home' ? undefined : page}
  alternate={alternate}
  fullBleed={page === 'home'}
  product={project?.data.slug}
  article={article?.data}
  ogImage={ogImage}
  app={app}
>
  {home && <Home entry={home} />}
  {page === 'about' && <About locale={locale} />}
  {
    !entry && (page === 'writing' || page === 'projects') && (
      <section
        class={page === 'projects' ? 'project-gallery-page' : 'writing-list-page'}
      >
        <header class="reading-header">
          <h1>{t[page]}</h1>
        </header>
        {page === 'writing' ? (
          <WritingList items={writing} locale={locale} />
        ) : (
          <div class="project-gallery">
            {projects.map((item, index) => (
              <ProjectFeature
                item={item}
                locale={locale}
                priority={index === 0}
              />
            ))}
            {!projects.length && <p class="text-muted">{t.empty}</p>}
          </div>
        )}
      </section>
    )
  }
  {entry && <ContentDetail entry={entry} locale={locale} />}
</BaseLayout>
