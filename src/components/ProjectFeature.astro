---
import type { CollectionEntry } from 'astro:content';
import { contentPath, type Locale } from '../i18n';
const { item, locale } = Astro.props as {
  item: CollectionEntry<'projects'>;
  locale: Locale;
};
const cover = item.data.cover ?? item.data.hero;
const titleId = `project-title-${item.data.slug}`;
---

<article class="gallery-project">
  <a
    class="gallery-project-link"
    href={contentPath(locale, 'projects', item.data.slug)}
    aria-labelledby={titleId}
    data-analytics-placement="project_item"
    data-analytics-product={item.data.slug}
  >
    <figure class="gallery-cover">
      <img
        src={cover.src}
        alt={cover.alt}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="gallery-project-copy">
      <h2 id={titleId}>{item.data.name}</h2>
      <p class="gallery-statement">{item.data.statement}</p>
      <p class="gallery-description">{item.data.description}</p>
    </div>
  </a>
</article>
