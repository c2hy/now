---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path, sectionPath, type Locale } from '../i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
---

<BaseLayout
  locale={locale}
  title={locale === 'en' ? 'Page not found' : '没有找到这一页'}
  alternate={locale === 'en' ? '/zh/404' : '/404'}
  current="404"
>
  <section class="reading-column">
    <header class="reading-header">
      <h1>{locale === 'en' ? 'This page isn’t here.' : '没找到这一页。'}</h1>
    </header>
    <div class="prose">
      <p>
        {
          locale === 'en'
            ? 'It may have moved, or the address may be incomplete.'
            : '可能是地址不对，也可能内容已经换了位置。'
        }
      </p>
      <p class="contact-links">
        <a href={path(locale)} data-drip-placement="not_found_home"
          >{locale === 'en' ? 'Back home' : '回到首页'}</a
        >
        <a
          href={sectionPath(locale, 'writing')}
          data-drip-placement="not_found_notes"
          >{locale === 'en' ? 'Browse the writing' : '看看文章'}</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
