---
import type { Locale } from '../i18n';
import { sectionPath, ui } from '../i18n';
import { getCollection } from 'astro:content';
import { visible } from '../utils/content';
import WritingList from './WritingList.astro';
import ProjectFeature from './ProjectFeature.astro';
import { social } from '../data/profile';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const all = (await getCollection('writing'))
  .filter((e) => e.data.locale === locale && visible(e.data))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const selected = all.filter((e) => e.data.featured);
const writing = (selected.length ? selected : all).slice(0, 5);
const projects = (await getCollection('projects'))
  .filter((e) => e.data.locale === locale && visible(e.data) && e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24">
  <div class="mb-9 flex flex-wrap items-center justify-between gap-4 md:mb-12">
    <p class="eyebrow text-muted">
      {
        locale === 'en'
          ? 'Observations, notes, and software by Will'
          : 'Will 的观察、记录与软件'
      }
    </p><span class="eyebrow flex items-center gap-2 text-muted"
      ><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{
        locale === 'en'
          ? 'Self · technology · everyday life'
          : '人与自我 · 数字生活'
      }</span
    >
  </div>
  <h1 class="display hero-title">
    {
      locale === 'en' ? (
        <>
          Noticing what
          <br />
          usually goes
          <>
            <br />
            <em class="text-accent">unnoticed.</em>
          </>
        </>
      ) : (
        <>
          留意那些
          <br />
          <span class="text-accent">常被忽略的</span>
          <>
            <br />
            事。
          </>
        </>
      )
    }
  </h1>
  <div class="mt-9 grid gap-8 md:mt-12 md:grid-cols-[1fr_420px] md:items-end">
    <p
      class="max-w-[470px] text-[16px] leading-[1.8] text-muted md:text-[17px]"
    >
      {
        locale === 'en'
          ? 'I write about self, technology, and everyday life—and turn a few of those observations into software.'
          : '写人与自我、数字生活，也把其中一些观察做成软件。'
      }
    </p><div class="hidden items-end justify-between md:flex">
      <span class="text-5xl italic text-muted/60" aria-hidden="true">w.</span><a
        href="#notes"
        class="eyebrow flex min-h-11 items-center gap-4 text-muted"
        >{locale === 'en' ? 'A few things, below' : '往下，随意看看'}<span
          class="text-xl"
          aria-hidden="true">↓</span
        ></a
      >
    </div>
  </div>
</section>
<section id="notes" class="border-t border-ink pt-8 pb-16 md:pt-10 md:pb-24">
  <div
    class="mb-8 flex flex-wrap items-baseline justify-between gap-4 md:mb-10"
  >
    <div>
      <p class="eyebrow mb-4 text-muted">01 / {t.writing}</p><h2
        class="display section-title"
      >
        {t.noting}
      </h2>
    </div><a class="text-link" href={sectionPath(locale, 'writing')}
      >{t.allWriting}<span aria-hidden="true">→</span></a
    >
  </div><WritingList items={writing} locale={locale} />
</section>
<section class="border-t border-ink pt-8 md:pt-10">
  <div class="mb-10 flex flex-wrap items-baseline justify-between gap-4">
    <div>
      <p class="eyebrow mb-4 text-muted">02 / {t.projects}</p><h2
        class="display section-title"
      >
        {t.making}
      </h2>
    </div><a class="text-link" href={sectionPath(locale, 'projects')}
      >{t.allProjects}<span aria-hidden="true">→</span></a
    >
  </div>{
    projects.map((item, index) => (
      <ProjectFeature item={item} locale={locale} index={index} />
    ))
  }
</section>
<section
  class="mt-3 grid gap-8 border-t border-ink pt-9 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:pt-12"
>
  <div>
    <p class="eyebrow mb-5 text-muted">03 / {t.about}</p><h2
      class="display section-title"
    >
      {
        locale === 'en' ? (
          <>
            The person behind the
            <br />
            notes and software.
          </>
        ) : (
          <>
            这些记录和软件
            <br />
            背后的人。
          </>
        )
      }
    </h2>
  </div><div>
    <p class="max-w-xl font-display text-[28px] leading-[1.4] md:text-[34px]">
      {
        locale === 'en'
          ? 'I’m Will, an independent developer. I write about how software enters our memory, our relationships, and the ways we understand ourselves.'
          : '我是 Will，一名独立开发者。我记录人与自我、数字生活，以及软件如何进入真实生活。'
      }
    </p><p class="mt-5 max-w-lg text-[15px] leading-[1.8] text-muted">
      {
        locale === 'en'
          ? 'This site brings together my observations, the judgments that grow from them, and the few ideas I have turned into software.'
          : '这里收着我的观察、由它们延伸出的判断，以及少数被做成软件的想法。'
      }
    </p><a class="text-link mt-6" href={sectionPath(locale, 'about')}
      >{t.aboutLink}<span aria-hidden="true">↗</span></a
    >
  </div>
</section>
{
  social.length > 0 && (
    <section class="mt-16 flex flex-wrap gap-6 border-t border-line pt-8">
      <h2 class="eyebrow mr-auto">{t.elsewhere}</h2>
      {social.map((link) => (
        <a
          class="text-link"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label} ↗
        </a>
      ))}
    </section>
  )
}
