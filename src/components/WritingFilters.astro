---
import {
  sectionPath,
  ui,
  writingCategoryLabels,
  writingCategorySlugs,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<nav
  class="mb-8 flex flex-wrap gap-2 md:mb-10"
  aria-label={t.categoryFilterLabel}
  data-writing-filters
>
  <a
    href={sectionPath(locale, 'writing')}
    class="inline-flex min-h-11 items-center border border-line px-4 py-2 text-sm transition-colors hover:border-ink hover:bg-surface"
    data-category-filter="all"
    data-active="true"
    aria-current="page"
  >
    {t.allCategories}
  </a>
  {
    writingCategorySlugs.map((category) => (
      <a
        href={`${sectionPath(locale, 'writing')}?category=${category}`}
        class="inline-flex min-h-11 items-center border border-line px-4 py-2 text-sm transition-colors hover:border-ink hover:bg-surface"
        data-category-filter={category}
      >
        {writingCategoryLabels[locale][category]}
      </a>
    ))
  }
</nav>

<script>
  const filters = document.querySelector<HTMLElement>('[data-writing-filters]');

  if (filters) {
    const controls = Array.from(
      filters.querySelectorAll<HTMLAnchorElement>('[data-category-filter]'),
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>('[data-writing-item]'),
    );
    const emptyState = document.querySelector<HTMLElement>(
      '[data-writing-filter-empty]',
    );
    const validCategories = new Set(
      controls.map((control) => control.dataset.categoryFilter),
    );

    const applyFilter = (requested: string, updateUrl = false) => {
      const category = validCategories.has(requested) ? requested : 'all';
      let visibleIndex = 0;

      items.forEach((item) => {
        const isVisible =
          category === 'all' || item.dataset.category === category;
        item.hidden = !isVisible;

        if (isVisible) {
          visibleIndex += 1;
          const index = item.querySelector<HTMLElement>('[data-writing-index]');
          if (index) index.textContent = String(visibleIndex).padStart(2, '0');
        }
      });

      controls.forEach((control) => {
        const isActive = control.dataset.categoryFilter === category;
        if (isActive) control.setAttribute('aria-current', 'page');
        else control.removeAttribute('aria-current');
        control.dataset.active = String(isActive);
      });
      emptyState?.toggleAttribute('hidden', visibleIndex > 0);

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        window.history.replaceState(
          {},
          '',
          `${url.pathname}${url.search}${url.hash}`,
        );
      }
    };

    applyFilter(
      new URLSearchParams(window.location.search).get('category') ?? 'all',
    );

    filters.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const control = event.target.closest<HTMLAnchorElement>(
        '[data-category-filter]',
      );
      if (!control) return;
      event.preventDefault();
      applyFilter(control.dataset.categoryFilter ?? 'all', true);
    });
  }
</script>

<style>
  [data-category-filter][data-active='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  [data-category-filter][data-active='true']:hover {
    color: var(--color-paper);
  }
</style>
