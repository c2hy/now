---
import { render, type CollectionEntry } from 'astro:content';
import { date, sectionPath, type Locale } from '../i18n';
import { profile } from '../data/profile';
const { entry, locale } = Astro.props as {
  entry: CollectionEntry<'writing'> | CollectionEntry<'projects'>;
  locale: Locale;
};
const article = entry.collection === 'writing' ? entry : undefined;
const project = entry.collection === 'projects' ? entry : undefined;
const { Content } = await render(entry);
---

<article class="reading-column content-detail">
  <header class="reading-header">
    <h1>{article?.data.title ?? project?.data.name}</h1>
    {
      article && (
        <p class="article-date">
          <a
            href={sectionPath(locale, 'about')}
            rel="author"
            data-analytics-placement="article_author"
          >
            {profile.name}
          </a>
          <span aria-hidden="true"> · </span>
          <time datetime={article.data.publishedAt.toISOString()}>
            {date(article.data.publishedAt, locale)}
          </time>
          {article.data.updatedAt && (
            <>
              · {locale === 'en' ? 'Updated' : '更新于'}{' '}
              <time datetime={article.data.updatedAt.toISOString()}>
                {date(article.data.updatedAt, locale)}
              </time>
            </>
          )}
        </p>
      )
    }
    {project && <p class="project-intro">{project.data.statement}</p>}
    {
      project && project.data.links.length > 0 && (
        <div
          class="project-links"
          aria-label={locale === 'en' ? 'Project links' : '作品链接'}
        >
          {project.data.links.map((link) => (
            <a
              href={link.href}
              data-analytics-placement={`project_link_${link.type.replaceAll('-', '_')}`}
              data-analytics-product={project.data.slug}
              data-analytics-store={
                link.type === 'app-store'
                  ? 'app_store'
                  : link.type === 'google-play'
                    ? 'google_play'
                    : undefined
              }
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
      )
    }
  </header>
  <div class="prose"><Content /></div>
</article>
