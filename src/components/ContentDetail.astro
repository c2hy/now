---
import { render, type CollectionEntry } from 'astro:content';
import { ui, sectionPath, date, type Locale } from '../i18n';
interface Props {
  entry: CollectionEntry<'writing'> | CollectionEntry<'projects'>;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const t = ui[locale];
const page = entry.collection;
const article = entry.collection === 'writing' ? entry : undefined;
const project = entry.collection === 'projects' ? entry : undefined;
const title = article?.data.title ?? project?.data.name;
const { Content } = await render(entry);
---

<article>
  <header
    class:list={[
      'pt-10 pb-9 md:pt-16 md:pb-12',
      article && 'mx-auto max-w-[850px]',
    ]}
  >
    <a
      class="eyebrow inline-flex min-h-11 items-center gap-3 text-muted"
      href={sectionPath(locale, page)}
      data-drip-placement="content_back"
    >
      {
        article
          ? locale === 'zh'
            ? '← 返回记录列表'
            : '← Back to Notes'
          : `← ${t[page as 'writing' | 'projects']}`
      }
    </a>
    <h1 class="display page-title mt-5">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
      {project?.data.statement ?? article?.data.description}
    </p>
    {
      project?.data.status === 'active' && (
        <p class="eyebrow mt-5 text-accent">{t.live}</p>
      )
    }
    {
      project && project.data.links.length > 0 && (
        <div
          class="mt-7 flex flex-wrap gap-x-7 gap-y-1 border-t border-line pt-3"
          aria-label={locale === 'en' ? 'Project links' : '作品链接'}
        >
          {project.data.links.map((link) => (
            <a
              class="text-link"
              href={link.href}
              data-drip-placement={`project_link_${link.type}`}
              data-drip-product={project.data.slug}
              data-drip-destination={
                link.type === 'app-store'
                  ? 'app_store'
                  : link.type === 'google-play'
                    ? 'google_play'
                    : undefined
              }
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )
    }
    {
      article && (
        <p class="mt-8 text-xs text-muted">
          <time datetime={article.data.publishedAt.toISOString()}>
            {date(article.data.publishedAt, locale)}
          </time>{' '}
          <span class="mx-3">/</span> Will{' '}
          {article.data.updatedAt && (
            <>
              {' '}
              · {locale === 'en' ? 'Updated' : '更新于'}{' '}
              {date(article.data.updatedAt, locale)}
            </>
          )}
        </p>
      )
    }
  </header>
  {
    project && (
      <figure>
        <img
          src={project.data.hero.src}
          alt={project.data.hero.alt}
          width={project.data.hero.width}
          height={project.data.hero.height}
          fetchpriority="high"
          class="mx-auto block h-auto w-auto max-h-[650px] max-w-full object-contain"
        />
      </figure>
    )
  }
  <div class:list={['mx-auto', article ? 'max-w-[850px]' : 'max-w-[700px]']}>
    <div class="prose mt-10 max-w-[700px]">
      {Content && <Content />}
    </div>
    <a
      class="text-link mt-12"
      href={sectionPath(locale, page)}
      data-drip-placement="content_back"
    >
      ← {t.back}{locale === 'en' ? ' ' : ''}{t[page as 'writing' | 'projects']}
    </a>
  </div>
</article>
