---
import type { CollectionEntry } from 'astro:content';
import {
  ui,
  contentPath,
  date,
  writingCategoryLabels,
  type Locale,
} from '../i18n';
interface Props {
  items: CollectionEntry<'writing'>[];
  locale: Locale;
  topRule?: boolean;
}
const { items, locale, topRule = false } = Astro.props;
---

<div class:list={[topRule && 'border-t border-line']} data-writing-list>
  {
    items.map((item, i) => (
      <a
        href={contentPath(locale, 'writing', item.data.slug)}
        data-drip-placement="note_item"
        data-writing-item
        data-category={item.data.category}
        class="group -mx-4 grid grid-cols-[24px_1fr_20px] items-start gap-4 px-4 py-8 transition-colors hover:bg-surface md:grid-cols-[40px_1fr_125px_24px] md:gap-6 md:py-10"
      >
        <span class="pt-1.5 text-xs text-muted" data-writing-index>
          {String(i + 1).padStart(2, '0')}
        </span>
        <div>
          <>
            <p class="mb-2 text-xs text-muted">
              {writingCategoryLabels[locale][item.data.category]}
            </p>
            <h3 class="font-display text-[27px] leading-tight tracking-tight md:text-[32px]">
              {item.data.title}
            </h3>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
              {item.data.description}
            </p>
            <time
              class="mt-3 block text-xs text-muted md:hidden"
              datetime={item.data.publishedAt.toISOString()}
            >
              {date(item.data.publishedAt, locale)}
            </time>
          </>
        </div>
        <>
          <time
            class="hidden pt-2 text-xs text-muted md:block"
            datetime={item.data.publishedAt.toISOString()}
          >
            {date(item.data.publishedAt, locale)}
          </time>
          <span class="arrow pt-1 text-xl" aria-hidden="true">
            ↗
          </span>
        </>
      </a>
    ))
  }
  {items.length === 0 && <p class="py-8 text-muted">{ui[locale].empty}</p>}
  <p class="py-8 text-muted" data-writing-filter-empty hidden>
    {ui[locale].noCategoryResults}
  </p>
</div>
