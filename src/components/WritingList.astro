---
import type { CollectionEntry } from 'astro:content';
import { ui, contentPath, date, type Locale } from '../i18n';
const { items, locale } = Astro.props as {
  items: CollectionEntry<'writing'>[];
  locale: Locale;
};
---

<div class="entry-list" data-writing-list>
  {
    items.map((item) => (
      <article class="list-entry" data-writing-item>
        <h2>
          <a
            href={contentPath(locale, 'writing', item.data.slug)}
            data-drip-placement="note_item"
          >
            {item.data.title}
          </a>
        </h2>
        <time class="entry-date" datetime={item.data.publishedAt.toISOString()}>
          {date(item.data.publishedAt, locale)}
        </time>
      </article>
    ))
  }
  {items.length === 0 && <p class="text-muted">{ui[locale].empty}</p>}
</div>
