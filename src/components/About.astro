---
import { type Locale } from '../i18n';
import { about } from '../data/about';
import { profile, social } from '../data/profile';
const { locale } = Astro.props as { locale: Locale };
const content = about[locale];
const contact =
  locale === 'zh'
    ? {
        title: '联系我',
        intro: '聊聊产品、分享想法，或者只是打个招呼，都欢迎。',
        email: '邮箱',
        profile: '查看主页',
      }
    : {
        title: 'Get in touch',
        intro:
          'Have a question, an idea to share, or just want to say hello? I’d love to hear from you.',
        email: 'Email',
        profile: 'View profile',
      };
---

<article class="reading-column about-page">
  <header class="reading-header">
    <h1>{locale === 'en' ? 'About Will' : '关于 Will'}</h1>
  </header>
  <div class="prose">
    {content.paragraphs.map((text) => <p>{text}</p>)}
    {
      content.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((text) => (
            <p>{text}</p>
          ))}
        </section>
      ))
    }
  </div>
  {
    (profile.email || social.length > 0) && (
      <section id="contact" class="about-contact" aria-labelledby="contact-title">
        <h2 id="contact-title">{contact.title}</h2>
        <p class="contact-intro">{contact.intro}</p>
        <ul class="contact-list" role="list">
          {profile.email && (
            <li>
              <a
                class="contact-link"
                href={`mailto:${profile.email}`}
                data-drip-placement="about_email"
              >
                <span class="contact-label">{contact.email}</span>
                <span class="contact-account">{profile.email}</span>
                <span class="contact-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          )}
          {social.map((link) => (
            <li>
              <a
                class="contact-link"
                href={link.href}
                data-drip-placement="about_social"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-label">{link.label}</span>
                <span class="contact-account">
                  {link.account ?? contact.profile}
                </span>
                <span class="contact-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>
