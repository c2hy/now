---
import { ui, path, type Locale } from '../i18n';
import { about } from '../data/about';
const { locale } = Astro.props as { locale: Locale };
const content = about[locale];
const t = ui[locale];
---

<section class="pt-10 pb-8 md:pt-16 md:pb-10">
  <p class="eyebrow mb-5 text-muted">
    {locale === 'en' ? 'About Will' : '关于 Will'}
  </p><h1 class="display page-title">
    {
      locale === 'en' ? (
        <>
          Hello, I’m Will<span class="text-accent">.</span>
        </>
      ) : (
        <>
          你好，我是 Will<span class="text-accent">。</span>
        </>
      )
    }
  </h1>
</section>
<div
  class="grid gap-10 border-t border-line pt-10 md:grid-cols-[.6fr_1.4fr] md:gap-20"
>
  <aside class="text-muted">
    <img
      src="/avatar.svg"
      alt={locale === 'en' ? 'Will.OPC avatar' : 'Will.OPC 头像'}
      width="144"
      height="144"
      class="mb-8 h-36 w-36 rounded-full border border-line"
    /><p class="eyebrow">
      {
        locale === 'en'
          ? 'Independent developer · Shanghai'
          : '独立开发者 · 上海'
      }
    </p>
  </aside><div class="max-w-[700px]">
    <p class="font-display text-[27px] leading-[1.4] md:text-[38px]">
      {t.siteIntro}
    </p><div class="prose">
      {content.paragraphs.map((text) => <p>{text}</p>)}{
        content.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs.map((text) => (
              <p>{text}</p>
            ))}
          </section>
        ))
      }
    </div><a class="text-link mt-6" href={path(locale, 'projects')}
      >{t.allProjects}<span aria-hidden="true">→</span></a
    >
  </div>
</div>
