---
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { chineseFontStyles } from '../utils/fonts';
import { profile, social } from '../data/profile';
import { ui, path, sectionPath, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  title: string;
  metaTitle?: string;
  description?: string;
  current?: string;
  alternate?: string;
  product?: string;
  article?: { publishedAt: Date; updatedAt?: Date };
  ogImage?: { path: string; alt: string; width?: number; height?: number };
}
const {
  locale,
  title,
  metaTitle,
  description = ui[locale].siteIntro,
  current,
  alternate,
  product,
  article,
  ogImage = {
    path: `/og/${locale}/site.png`,
    alt: ui[locale].homeTitle,
    width: 1200,
    height: 630,
  },
} = Astro.props;
const t = ui[locale];
const content = await Astro.slots.render('default');
const fontStyles = chineseFontStyles(
  `${JSON.stringify([t, profile])}${content}`,
);
const other = locale === 'en' ? 'zh' : 'en';
// Static directory output adds a slash; keep metadata aligned with public links
// and the sitemap, including the language home pages.
const canonical = new URL(
  current ? Astro.url.pathname.replace(/\/+$/, '') : path(locale),
  profile.site,
).href;
const ogImageUrl = new URL(`${ogImage.path}?v=7`, profile.site).href;
const ogImageWidth = ogImage.width ?? 1200;
const ogImageHeight = ogImage.height ?? 630;
const resolvedTitle = metaTitle ?? title;
const browserTitle =
  current && !resolvedTitle.includes(profile.siteName)
    ? `${resolvedTitle} — ${profile.siteName}`
    : resolvedTitle;
const mixpanelToken = import.meta.env.PUBLIC_MIXPANEL_TOKEN?.trim();
const analyticsEnabled =
  import.meta.env.PUBLIC_MIXPANEL_ENABLED !== 'false' &&
  import.meta.env.PREVIEW_CONTENT !== 'true';
const analyticsConfigured =
  import.meta.env.PROD && analyticsEnabled && !!mixpanelToken;
// Index pages by default; set PUBLIC_INDEXING_ENABLED=false for previews or
// other deployments that should remain out of search results.
const indexingEnabled = import.meta.env.PUBLIC_INDEXING_ENABLED !== 'false';
const robots = !indexingEnabled
  ? 'noindex, nofollow'
  : current === '404'
    ? 'noindex, follow'
    : 'index, follow';
const alternatePath =
  alternate ??
  (current === 'writing' || current === 'projects' || current === 'about'
    ? sectionPath(other, current)
    : path(other, current || ''));
const isDetail =
  ['writing', 'projects'].includes(current || '') &&
  Astro.url.pathname.split('/').filter((part) => part && part !== 'zh').length >
    1;
const paired =
  current !== '404' && (!isDetail || !['/', '/zh/'].includes(alternatePath));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${profile.site}/#person`,
      name: profile.name,
      alternateName: [profile.siteName, profile.alternateName],
      url: `${profile.site}/`,
      image: `${profile.site}/avatar.svg`,
      sameAs: social.map(({ href }) => href),
    },
    {
      '@type': 'WebSite',
      '@id': `${profile.site}/#website`,
      name: profile.siteName,
      alternateName: profile.alternateName,
      url: `${profile.site}/`,
      inLanguage: ['en', 'zh-CN'],
      publisher: { '@id': `${profile.site}/#person` },
    },
    ...(article
      ? [
          {
            '@type': 'Article',
            '@id': `${canonical}#article`,
            url: canonical,
            mainEntityOfPage: canonical,
            headline: title,
            description,
            image: ogImageUrl,
            inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
            datePublished: article.publishedAt.toISOString(),
            dateModified: (
              article.updatedAt || article.publishedAt
            ).toISOString(),
            author: { '@id': `${profile.site}/#person` },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link
      rel="preload"
      href={interFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fontStyles}></style>
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = (
          stored ? stored === 'dark' : systemDark
        )
          ? 'dark'
          : 'light';
      })();
    </script>
    <noscript>
      <style>
        .theme-toggle {
          display: none;
        }
      </style>
    </noscript>
    <title>{browserTitle}</title><meta
      name="description"
      content={description}
    /><meta name="author" content={profile.siteName} /><meta
      name="robots"
      content={robots}
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" /><link
      rel="icon"
      type="image/svg+xml"
      href="/avatar.svg"
    /><link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    /><link rel="canonical" href={canonical} />
    {
      paired && (
        <>
          <>
            <link
              rel="alternate"
              hreflang={locale === 'zh' ? 'zh-CN' : 'en'}
              href={canonical}
            />
            <link
              rel="alternate"
              hreflang={other === 'zh' ? 'zh-CN' : 'en'}
              href={new URL(alternatePath, profile.site).href}
            />
          </>
        </>
      )
    }
    {
      paired && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={
            locale === 'en'
              ? canonical
              : new URL(alternatePath, profile.site).href
          }
        />
      )
    }
    <meta property="og:title" content={browserTitle} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:type"
      content={article ? 'article' : 'website'}
    /><meta
      property="og:locale"
      content={locale === 'zh' ? 'zh_CN' : 'en_US'}
    /><meta property="og:site_name" content={profile.siteName} /><meta
      property="og:image"
      content={ogImageUrl}
    /><meta property="og:image:secure_url" content={ogImageUrl} /><meta
      property="og:image:type"
      content="image/png"
    /><meta property="og:image:width" content={String(ogImageWidth)} /><meta
      property="og:image:height"
      content={String(ogImageHeight)}
    /><meta property="og:image:alt" content={ogImage.alt} /><meta
      name="twitter:card"
      content="summary_large_image"
    /><meta name="twitter:title" content={browserTitle} /><meta
      name="twitter:description"
      content={description}
    /><meta name="twitter:image" content={ogImageUrl} /><meta
      name="twitter:image:alt"
      content={ogImage.alt}
    />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.publishedAt.toISOString()}
          />
          <meta
            property="article:modified_time"
            content={(article.updatedAt || article.publishedAt).toISOString()}
          />
        </>
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  </head>
  <body
    data-analytics-token={analyticsConfigured ? mixpanelToken : undefined}
    data-analytics-product={analyticsConfigured ? product : undefined}
  >
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="shell">
        <a
          href={path(locale)}
          data-analytics-placement="header_brand"
          class="site-brand"
          aria-label="Will.OPC"
          aria-current={!current ? 'page' : undefined}
        >
          <span>Will<span class="text-accent">.</span>OPC</span>
        </a>
        <nav
          class="site-nav"
          aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}
        >
          {
            (['projects', 'writing', 'about'] as const).map((item) => (
              <a
                aria-current={current === item ? 'page' : undefined}
                href={sectionPath(locale, item)}
                data-analytics-placement={`nav_${item}`}
              >
                {t[item]}
              </a>
            ))
          }
          <a
            class="language-link"
            href={alternatePath}
            data-analytics-placement="language_switch"
            lang={other === 'zh' ? 'zh-CN' : 'en'}
            aria-label={t.langLabel}>{t.language}</a
          >
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={t.themeLabel}
          >
            <svg
              data-icon="moon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M20.4 14.7A8.6 8.6 0 1 1 9.3 3.6a6.9 6.9 0 0 0 11.1 11.1Z"
              ></path>
            </svg>
            <svg
              data-icon="sun"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4.2"></circle>
              <path
                d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M5.4 18.6 7 17M17 7l1.6-1.6"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <div class="shell">
      <main id="main"><Fragment set:html={content} /></main>
    </div>
    <script src="../scripts/theme.ts"></script>
    {analyticsConfigured && <script src="../scripts/analytics.ts" />}
  </body>
</html>
