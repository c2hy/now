---
// 拉丁走系统字体，不再加载 Latin webfont。
// 中文子集由 scripts/subset-fonts.mjs 生成，随站点打包，运行时无外部请求。
import sansScFontUrl from '../assets/fonts/sans-sc-400.woff2?url';
import serifDisplayFontUrl from '../assets/fonts/serif-sc-display-400.woff2?url';
import '../styles/global.css';
// 预览构建专用字体诊断源码；正式构建不渲染，因此不会内联、也不会输出 CDN 地址。
import fontDebugSource from '../scripts/font-debug.js?raw';
// 预览构建专用的超家族实验：切换字族的 @font-face 与覆盖规则。正式构建不渲染。
import FontFamilyPreview from '../components/FontFamilyPreview.astro';
// 预览构建专用的字体变体（?variant=a|b|system）。正式构建不内联。
import typeVariantsCss from '../styles/type-variants.css?raw';
import { profile, social } from '../data/profile';
import { ui, path, sectionPath, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  title: string;
  metaTitle?: string;
  description?: string;
  current?: string;
  alternate?: string;
  /** 覆盖默认 canonical（预览专用页面用，避免与正式页面重复）。 */
  canonicalPath?: string;
  /** 预览专用页面不声明 hreflang，避免指向不存在的语言版本。 */
  noAlternates?: boolean;
  noindex?: boolean;
  /** 首页通栏版式：页头 fixed 浮在画上，正文跳出 .shell 的宽度包裹。 */
  fullBleed?: boolean;
  product?: string;
  article?: { publishedAt: Date; updatedAt?: Date };
  ogImage?: { path: string; alt: string; width?: number; height?: number };
  app?: {
    name: string;
    description: string;
    category: string;
    operatingSystem: string;
    url: string;
    downloadUrl: string;
    sameAs: string[];
  };
}
const {
  locale,
  title,
  metaTitle,
  description = ui[locale].siteIntro,
  current,
  alternate,
  canonicalPath,
  noAlternates = false,
  noindex = false,
  fullBleed = false,
  product,
  article,
  app,
  ogImage = {
    path: `/og/${locale}/site.png`,
    alt: ui[locale].homeTitle,
    width: 1200,
    height: 630,
  },
} = Astro.props;
const t = ui[locale];
const content = await Astro.slots.render('default');
const other = locale === 'en' ? 'zh' : 'en';
// Static directory output adds a slash; keep metadata aligned with public links
// and the sitemap, including the language home pages.
const canonical = new URL(
  canonicalPath ??
    (current ? Astro.url.pathname.replace(/\/+$/, '') : path(locale)),
  profile.site,
).href;
const ogImageUrl = new URL(`${ogImage.path}?v=9`, profile.site).href;
const ogImageWidth = ogImage.width ?? 1200;
const ogImageHeight = ogImage.height ?? 630;
// 分享图类型跟随文件扩展名：首页的莫奈照片用 JPG 压到 200KB 以内，
// 其余构建期生成的文字图仍是 PNG。
const ogImageType = /\.jpe?g$/i.test(ogImage.path)
  ? 'image/jpeg'
  : 'image/png';
const resolvedTitle = metaTitle ?? title;
// 标题由各页面显式给出品牌（仅首页、关于、404），这里不再统一追加站点名，
// 否则内页会多出 11 个字符并被搜索结果截断。
const browserTitle = resolvedTitle;
const mixpanelToken = import.meta.env.PUBLIC_MIXPANEL_TOKEN?.trim();
const analyticsEnabled =
  import.meta.env.PUBLIC_MIXPANEL_ENABLED !== 'false' &&
  import.meta.env.PREVIEW_CONTENT !== 'true';
const analyticsConfigured =
  import.meta.env.PROD && analyticsEnabled && !!mixpanelToken;
// Index pages by default; set PUBLIC_INDEXING_ENABLED=false for previews or
// other deployments that should remain out of search results.
const indexingEnabled = import.meta.env.PUBLIC_INDEXING_ENABLED !== 'false';
const robots = !indexingEnabled
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : current === '404'
      ? 'noindex, follow'
      : 'index, follow';
const alternatePath =
  alternate ??
  (current === 'writing' || current === 'projects' || current === 'about'
    ? sectionPath(other, current)
    : path(other, current || ''));
const isDetail =
  ['writing', 'projects'].includes(current || '') &&
  Astro.url.pathname.split('/').filter((part) => part && part !== 'zh').length >
    1;
const paired =
  !noAlternates &&
  current !== '404' &&
  (!isDetail || !['/', '/zh/'].includes(alternatePath));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${profile.site}/#person`,
      name: profile.name,
      // 站点名的两种写法都作为别名保留，便于检索 "willopc" 时把人与站点归并到同一实体。
      alternateName: [profile.siteName, profile.alternateName],
      url: `${profile.site}/`,
      image: `${profile.site}/avatar.svg`,
      sameAs: social.map(({ href }) => href),
    },
    {
      '@type': 'WebSite',
      '@id': `${profile.site}/#website`,
      name: profile.siteName,
      alternateName: profile.alternateName,
      url: `${profile.site}/`,
      inLanguage: ['en', 'zh-CN'],
      publisher: { '@id': `${profile.site}/#person` },
    },
    ...(app
      ? [
          {
            '@type': 'SoftwareApplication',
            '@id': `${canonical}#app`,
            name: app.name,
            description: app.description,
            applicationCategory: app.category,
            operatingSystem: app.operatingSystem,
            url: app.url,
            downloadUrl: app.downloadUrl,
            sameAs: app.sameAs,
            inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
            offers: {
              '@type': 'Offer',
              price: 0,
              priceCurrency: 'USD',
              description:
                locale === 'zh'
                  ? '免费下载；Premium 为一次性购买。'
                  : 'Free download; Premium is a one-time purchase.',
            },
            author: { '@id': `${profile.site}/#person` },
          },
        ]
      : []),
    ...(article
      ? [
          {
            '@type': 'Article',
            '@id': `${canonical}#article`,
            url: canonical,
            mainEntityOfPage: canonical,
            headline: title,
            description,
            image: ogImageUrl,
            inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
            datePublished: article.publishedAt.toISOString(),
            dateModified: (
              article.updatedAt || article.publishedAt
            ).toISOString(),
            author: { '@id': `${profile.site}/#person` },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    {
      /* 中文页预加载正文黑体 400 与 h1 宋体小档（合计约 178KB）；英文页零字体请求。
         预览构建不预加载中文：?variant=system 的中文走系统字体，
         预加载会让变体对比凭空多出 178KB。 */
      locale === 'zh' && import.meta.env.PREVIEW_CONTENT !== 'true' ? (
        <>
          <link
            rel="preload"
            href={sansScFontUrl}
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href={serifDisplayFontUrl}
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      ) : null
    }
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = (
          stored ? stored === 'dark' : systemDark
        )
          ? 'dark'
          : 'light';
      })();
    </script>
    <noscript>
      <style>
        .theme-toggle {
          display: none;
        }
      </style>
    </noscript>
    {import.meta.env.PREVIEW_CONTENT === 'true' && (
      <script is:inline>
        (() => {
          const family = new URLSearchParams(location.search).get('family');
          if (family === 'sans-title' || family === 'sans-body')
            document.documentElement.dataset.family = family;
          const variant = new URLSearchParams(location.search).get('variant');
          if (variant === 'a' || variant === 'b' || variant === 'system')
            document.documentElement.dataset.variant = variant;
        })();
      </script>
    )}
    {
      /* 预览构建专用：字体变体。放在 head 里，切换参数不会闪默认字体。 */
      import.meta.env.PREVIEW_CONTENT === 'true' && (
        <style is:inline set:html={typeVariantsCss} />
      )
    }
    <title>{browserTitle}</title><meta
      name="description"
      content={description}
    /><meta name="author" content={profile.siteName} /><meta
      name="robots"
      content={robots}
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" /><link
      rel="icon"
      type="image/svg+xml"
      href="/avatar.svg"
    /><link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    /><link rel="canonical" href={canonical} />
    {
      paired && (
        <>
          <>
            <link
              rel="alternate"
              hreflang={locale === 'zh' ? 'zh-CN' : 'en'}
              href={canonical}
            />
            <link
              rel="alternate"
              hreflang={other === 'zh' ? 'zh-CN' : 'en'}
              href={new URL(alternatePath, profile.site).href}
            />
          </>
        </>
      )
    }
    {
      paired && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={
            locale === 'en'
              ? canonical
              : new URL(alternatePath, profile.site).href
          }
        />
      )
    }
    <meta property="og:title" content={browserTitle} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:type"
      content={article ? 'article' : 'website'}
    /><meta
      property="og:locale"
      content={locale === 'zh' ? 'zh_CN' : 'en_US'}
    /><meta property="og:site_name" content={profile.siteName} /><meta
      property="og:image"
      content={ogImageUrl}
    /><meta property="og:image:secure_url" content={ogImageUrl} /><meta
      property="og:image:type"
      content={ogImageType}
    /><meta property="og:image:width" content={String(ogImageWidth)} /><meta
      property="og:image:height"
      content={String(ogImageHeight)}
    /><meta property="og:image:alt" content={ogImage.alt} /><meta
      name="twitter:card"
      content="summary_large_image"
    /><meta name="twitter:title" content={browserTitle} /><meta
      name="twitter:description"
      content={description}
    /><meta name="twitter:image" content={ogImageUrl} /><meta
      name="twitter:image:alt"
      content={ogImage.alt}
    />
    {
      article && (
        <>
          <meta
            property="article:published_time"
            content={article.publishedAt.toISOString()}
          />
          <meta
            property="article:modified_time"
            content={(article.updatedAt || article.publishedAt).toISOString()}
          />
        </>
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  </head>
  <body
    class={fullBleed ? 'home' : undefined}
    data-analytics-token={analyticsConfigured ? mixpanelToken : undefined}
    data-analytics-product={analyticsConfigured ? product : undefined}
  >
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="shell">
        {
          /* 首页 h1 = 站点标题（可见 wordmark）；内页 wordmark 退回普通链接，
             各页 h1 仍是页面自身标题。H1 不是排名因素，数量保持每页 1。 */
          !current ? (
            <h1 class="site-brand">
              <a
                href={path(locale)}
                data-analytics-placement="header_brand"
                aria-label="Will.OPC"
                aria-current="page"
              >
                <span>Will<span class="text-accent">.</span>OPC</span>
              </a>
            </h1>
          ) : (
            <a
              href={path(locale)}
              data-analytics-placement="header_brand"
              class="site-brand"
              aria-label="Will.OPC"
            >
              <span>Will<span class="text-accent">.</span>OPC</span>
            </a>
          )
        }
        <nav
          class="site-nav"
          aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}
        >
          {
            (['projects', 'writing', 'about'] as const).map((item) => (
              <a
                aria-current={current === item ? 'page' : undefined}
                href={sectionPath(locale, item)}
                data-analytics-placement={`nav_${item}`}
              >
                {t[item]}
              </a>
            ))
          }
          <a
            class="language-link"
            href={alternatePath}
            data-analytics-placement="language_switch"
            lang={other === 'zh' ? 'zh-CN' : 'en'}
            aria-label={t.langLabel}>{t.language}</a
          >
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={t.themeLabel}
          >
            <svg
              data-icon="moon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M20.4 14.7A8.6 8.6 0 1 1 9.3 3.6a6.9 6.9 0 0 0 11.1 11.1Z"
              ></path>
            </svg>
            <svg
              data-icon="sun"
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="4.2"></circle>
              <path
                d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M5.4 18.6 7 17M17 7l1.6-1.6"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    {
      fullBleed ? (
        <main id="main">
          <Fragment set:html={content} />
        </main>
      ) : (
        <div class="shell">
          <main id="main">
            <Fragment set:html={content} />
          </main>
        </div>
      )
    }
    <script src="../scripts/theme.ts"></script>
    {analyticsConfigured && <script src="../scripts/analytics.ts" />}
    {
      import.meta.env.PREVIEW_CONTENT === 'true' && (
        <script is:inline set:html={fontDebugSource} />
      )
    }
    {import.meta.env.PREVIEW_CONTENT === 'true' && <FontFamilyPreview />}
  </body>
</html>
